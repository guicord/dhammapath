# Local development: a single Postgres instance covers both migrations and
# runtime queries. In production (Vercel), Supabase's Vercel integration sets
# POSTGRES_URL_NON_POOLING (direct, used for migrations/seeding) and
# POSTGRES_PRISMA_URL (pooled, used at runtime) instead of this variable —
# see prisma7.config.ts, prisma/seed.ts, and lib/content/prisma.ts.
DATABASE_URL="postgresql://gc@localhost:5432/dhammapath?schema=public"
